/.phpunit.cache
/node_modules
/public/build
/public/hot
/public/attachments/customer
/storage/*.key

# Runtime per-record upload dirs: storage/app/<id>/photo_service_*.jpg, created
# by the app at runtime (one numeric dir per record, ~240 of them) and pure
# noise in `git status`. Ignore ONLY the numeric dirs. storage/app/public/ is
# intentionally tracked (dir_sign.jpg, mkt_sign.jpg, glExport.xlsx) and is NOT
# matched by this pattern. Note: 11 older photo_service*.jpg files under numeric
# dirs are already tracked from before this rule; they stay tracked and are left
# untouched (none of this rule's contents are deleted or moved).
/storage/app/[0-9]*/
/vendor
.env
.env.backup
.env.production
# Real env files and hand-made backups. The explicit name list above missed
# .env.orig and .env.bak* - each holds APP_KEY, DB_PASSWORD, AWS and Pusher
# secrets, and this repo is PUBLIC on GitHub, so one `git add -A` would
# publish them. .env.example stays tracked (it is a template with empty values).
.env.*
!.env.example
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.vscode
.aider*

# Yarn is the single authoritative package manager (packageManager: yarn@3.6.1,
# .yarnrc.yml -> nodeLinker: node-modules, yarn.lock is the source of truth).
# npm/bun lockfiles are NOT authoritative - keeping them makes installs
# non-reproducible and lets `npm install` (which fails here on vite peer
# conflicts) silently resolve a different tree. One repo, one lockfile.
/package-lock.json
/tribinapp/package-lock.json
/tribinapp/bun.lockb
/bun.lockb

# Generated Quasar entry view (built/uploaded by tribinapp/deploy.ps1)
/resources/views/tribinapp.blade.php
